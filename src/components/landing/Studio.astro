---
import { site, partner } from '../../data/site';
---

<section class="section studio" id="studio">
  <div class="container">
    <div class="studio__header reveal">
      <span class="mono-label">Con chi lavoro / Who I work with</span>
      <h2 class="studio__title">
        Un duo <span class="studio__title-em">complementare</span>
      </h2>
      <p class="studio__lead">
        Insieme copriamo l'intero spettro delle soluzioni digitali per PMI — dalla sicurezza dell'infrastruttura al design che la rappresenta online.
      </p>
    </div>

    <div class="studio__grid">
      <div class="studio__card studio__card--alex reveal reveal-delay-1">
        <div class="studio__card-header">
          <span class="studio__initials studio__initials--alex">AC</span>
          <div>
            <h3 class="studio__card-name">{site.name}</h3>
            <p class="studio__card-role">IT · Security · Backend · Automation</p>
          </div>
        </div>
        <p class="studio__card-desc">
          Architetture a microservizi, cybersecurity, database design, automazione workflow. Il lato infrastrutturale e tecnico.
        </p>
        <div class="studio__skills">
          <span class="studio__skill">Python</span>
          <span class="studio__skill">Go</span>
          <span class="studio__skill">PostgreSQL</span>
          <span class="studio__skill">Docker</span>
          <span class="studio__skill">Security Audit</span>
        </div>
        <span class="studio__card-badge studio__card-badge--you">Tu stai qui</span>
      </div>

      <div class="studio__divider reveal reveal-delay-2" aria-hidden="true">
        <span>+</span>
      </div>

      <div class="studio__card studio__card--renan reveal reveal-delay-3">
        <div class="studio__card-header">
          <span class="studio__initials studio__initials--renan">RM</span>
          <div>
            <h3 class="studio__card-name">{partner.name}</h3>
            <p class="studio__card-role">Design · Frontend · SEO · Web Presence</p>
          </div>
        </div>
        <p class="studio__card-desc">
          Siti su misura, UI/UX design, SEO locale, gestione della presenza digitale. Il lato visivo e comunicativo.
        </p>
        <div class="studio__skills">
          <span class="studio__skill studio__skill--partner">HTML / CSS</span>
          <span class="studio__skill studio__skill--partner">Astro</span>
          <span class="studio__skill studio__skill--partner">SEO Locale</span>
          <span class="studio__skill studio__skill--partner">Adobe Suite</span>
        </div>
        <a href={partner.portfolio} target="_blank" rel="noopener" class="studio__card-link">
          Vedi portfolio
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
        </a>
      </div>
    </div>

    <p class="studio__tagline reveal">
      Insieme → <strong>studio digitale full-service per PMI</strong> — un punto di contatto, competenze complete.
    </p>
  </div>
</section>

<style>
  .studio {
    background: var(--bg-primary);
    border-top: 1px solid var(--hairline);
  }

  .studio__header {
    max-width: 640px;
    margin-bottom: 3rem;
  }

  .studio__title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-bright);
    margin: 0.5rem 0 1rem;
  }

  .studio__title-em {
    background: linear-gradient(118deg, var(--accent-blue), var(--accent-green));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .studio__lead {
    color: var(--text-secondary);
    line-height: 1.75;
    font-size: var(--text-base);
  }

  .studio__grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1.5rem;
    align-items: center;
    margin-bottom: 2.5rem;
  }

  .studio__card {
    position: relative;
    padding: 2rem;
    background: var(--bg-panel);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: border-color 0.3s var(--ease-out-expo);
  }

  .studio__card--alex {
    border-color: rgba(0, 200, 150, 0.2);
  }

  .studio__card--alex:hover {
    border-color: rgba(0, 200, 150, 0.45);
  }

  .studio__card--renan:hover {
    border-color: rgba(78, 143, 224, 0.35);
  }

  .studio__card-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .studio__initials {
    width: 48px;
    height: 48px;
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }

  .studio__initials--alex {
    background: var(--accent-green-dim);
    color: var(--accent-green);
    border: 1px solid rgba(0, 200, 150, 0.25);
  }

  .studio__initials--renan {
    background: var(--accent-blue-dim);
    color: var(--accent-blue);
    border: 1px solid rgba(78, 143, 224, 0.25);
  }

  .studio__card-name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text-bright);
    letter-spacing: -0.01em;
  }

  .studio__card-role {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    letter-spacing: 0.04em;
    margin-top: 0.15rem;
  }

  .studio__card-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  .studio__skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .studio__skill {
    padding: 0.2em 0.6em;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    background: var(--accent-green-dim);
    color: var(--accent-green);
    border: 1px solid rgba(0, 200, 150, 0.2);
  }

  .studio__skill--partner {
    background: var(--accent-blue-dim);
    color: var(--accent-blue);
    border: 1px solid rgba(78, 143, 224, 0.2);
  }

  .studio__card-badge {
    display: inline-block;
    padding: 0.2em 0.7em;
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    background: var(--accent-green-dim);
    color: var(--accent-green);
    border: 1px solid rgba(0, 200, 150, 0.3);
  }

  .studio__card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-blue);
    transition: color 0.2s, gap 0.2s var(--ease-out-expo);
  }

  .studio__card-link:hover {
    color: var(--accent-blue-bright);
    gap: 0.6rem;
  }

  .studio__divider {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 50%;
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .studio__tagline {
    text-align: center;
    font-size: var(--text-base);
    color: var(--text-secondary);
    padding: 1.5rem 2rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .studio__tagline strong {
    color: var(--text-bright);
  }

  @media (max-width: 900px) {
    .studio__grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .studio__divider {
      margin: 0 auto;
      transform: rotate(90deg);
    }
  }

  @media (max-width: 560px) {
    .studio__card { padding: 1.5rem; }
  }
</style>
