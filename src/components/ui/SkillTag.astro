---
interface Props {
  variant?: 'default' | 'green' | 'violet' | 'live';
}

const { variant = 'default' } = Astro.props;
---

<span class:list={['skill-tag', `skill-tag--${variant}`]}>
  <slot />
</span>

<style>
  .skill-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.28em 0.7em;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.04em;
    transition: background var(--dur), border-color var(--dur), color var(--dur);
  }

  .skill-tag--default {
    background: var(--accent-blue-dim);
    color: var(--accent-blue);
    border: 1px solid rgba(78, 143, 224, 0.2);
  }

  .skill-tag--green {
    background: var(--accent-green-dim);
    color: var(--accent-green);
    border: 1px solid rgba(0, 200, 150, 0.2);
  }

  .skill-tag--violet {
    background: var(--accent-violet-dim);
    color: var(--accent-violet);
    border: 1px solid rgba(155, 140, 255, 0.2);
  }

  .skill-tag--live {
    background: var(--accent-live-dim);
    color: var(--accent-live);
    border: 1px solid rgba(67, 209, 122, 0.2);
  }
</style>
