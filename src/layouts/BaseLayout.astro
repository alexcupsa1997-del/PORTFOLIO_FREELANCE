---
import SEOHead from '../components/global/SEOHead.astro';
import '../styles/variables.css';
import '../styles/typography.css';
import '../styles/global.css';
import '../styles/utilities.css';
import '../styles/animations.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Alexandru Cupsa — Web · Security · Database · Automation',
  description = 'Soluzioni IT su misura: web development, cybersecurity, database design e workflow automation. Verona, Italia.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="it">
<head>
  <SEOHead title={title} description={description} />
</head>
<body>
  <slot />
</body>
</html>
