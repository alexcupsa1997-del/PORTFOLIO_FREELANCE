---
import PageLayout from '../layouts/PageLayout.astro';
import { featuredProject } from '../data/projects';
---

<PageLayout
  title="Progetti — Alexandru Cupsa"
  description="Portfolio dei progetti di Alexandru Cupsa: GOLIATH V1 (trading ecosystem AI), sistemi a microservizi, cybersecurity."
>
  <section class="section projects-hero">
    <div class="container">
      <div class="projects-hero__content reveal">
        <span class="mono-label">Portfolio</span>
        <h1 class="projects-hero__title">Progetti</h1>
        <p class="projects-hero__lead">
          Sistemi progettati per reggere carichi reali — non demo, non tutorial. Ogni progetto qui sotto è in produzione o in sviluppo attivo.
        </p>
      </div>
    </div>
  </section>

  <section class="section projects-featured">
    <div class="container">
      <div class="pf-card reveal">
        <div class="pf-card__head">
          <div class="pf-card__status pf-card__status--private">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
            Privato
          </div>
          <h2 class="pf-card__title">{featuredProject.title}</h2>
          <p class="pf-card__desc">{featuredProject.desc}</p>
        </div>

        <div class="pf-card__stats-grid">
          {Object.entries(featuredProject.stats || {}).map(([key, val]) => (
            <div class="pf-stat">
              <span class="pf-stat__val">{val}</span>
              <span class="pf-stat__key">{key}</span>
            </div>
          ))}
        </div>

        <div class="pf-card__details">
          <div class="pf-detail-block">
            <h3 class="pf-detail__title">Architettura</h3>
            <ul class="pf-detail__list">
              <li>11 microservizi Docker (Python · Go · TypeScript/React)</li>
              <li>TimescaleDB per serie temporali, Redis pub/sub, ZeroMQ streaming</li>
              <li>AI Brain: pipeline segnali a 4 tier — ML (JEPA/GNN/PyTorch), rule-based, conservativo</li>
              <li>gRPC + Protobuf per comunicazione inter-servizio</li>
              <li>MetaTrader 5 bridge con 7 validazioni pre-ordine</li>
            </ul>
          </div>

          <div class="pf-detail-block">
            <h3 class="pf-detail__title">Sicurezza & Monitoring</h3>
            <ul class="pf-detail__list">
              <li>Audit trail SHA-256 immutabile (append-only)</li>
              <li>CTF security audit: 20 round, 7 fasi completate</li>
              <li>TLS/mTLS tra servizi, RBAC per-servizio PostgreSQL</li>
              <li>Prometheus + Grafana, 5 dashboard, 14 tool diagnostici</li>
              <li>Circuit breaker globale + kill switch multi-livello</li>
            </ul>
          </div>

          <div class="pf-detail-block">
            <h3 class="pf-detail__title">Qualità</h3>
            <ul class="pf-detail__list">
              <li>~3.000 test: pytest, Go test, E2E, DB integration</li>
              <li>GitHub Actions CI/CD: lint, typecheck, Docker build, Trivy scan, TruffleHog</li>
              <li>Backtest Monte Carlo: 1.000 trial, p&lt;0.05, 12 metriche finanziarie</li>
              <li>22 categorie console, ~155 operazioni diagnostiche</li>
            </ul>
          </div>
        </div>

        <div class="pf-card__tech">
          <span class="pf-tech__label">Stack completo</span>
          <div class="pf-tech__list">
            {featuredProject.tech.map(t => (
              <span class="pf-tech__chip">{t}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section projects-more">
    <div class="container">
      <div class="pm-header reveal">
        <h2 class="pm-title">Altri Progetti</h2>
        <p class="pm-desc">Progetti privati e lavori in corso — disponibili su richiesta per clienti qualificati.</p>
      </div>
      <div class="pm-grid">
        <div class="pm-card reveal reveal-delay-1">
          <span class="pm-card__label">In arrivo</span>
          <p class="pm-card__text">Altri progetti verranno aggiunti progressivamente.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section projects-cta">
    <div class="container">
      <div class="pcta reveal">
        <h2 class="pcta__title">Hai un progetto in mente?</h2>
        <p class="pcta__desc">Parliamone. Valuto ogni richiesta e rispondo entro 24 ore.</p>
        <a href="/#contatti" class="pcta__btn">Scrivimi</a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .projects-hero {
    background: var(--bg-primary);
    padding-top: calc(var(--nav-height) + 4rem);
  }

  .projects-hero__title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text-bright);
    margin: 0.5rem 0 1rem;
  }

  .projects-hero__lead {
    color: var(--text-secondary);
    font-size: var(--text-lg);
    line-height: 1.7;
    max-width: 56ch;
  }

  .projects-featured {
    background: var(--bg-secondary);
    border-top: 1px solid var(--hairline);
  }

  .pf-card {
    background: var(--bg-panel);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .pf-card__head {
    padding: 2.5rem 2.5rem 2rem;
    border-bottom: 1px solid var(--border);
  }

  .pf-card__status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2em 0.7em;
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    margin-bottom: 1rem;
  }

  .pf-card__status--private {
    background: rgba(224, 48, 64, 0.12);
    color: #E03040;
    border: 1px solid rgba(224, 48, 64, 0.25);
  }

  .pf-card__title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-bright);
    margin-bottom: 0.75rem;
  }

  .pf-card__desc {
    color: var(--text-secondary);
    line-height: 1.75;
    max-width: 72ch;
  }

  .pf-card__stats-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    padding: 1.75rem 2.5rem;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border);
  }

  .pf-stat { display: flex; flex-direction: column; gap: 0.15rem; }
  .pf-stat__val {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--accent-green);
    letter-spacing: -0.01em;
  }
  .pf-stat__key {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
  }

  .pf-card__details {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    padding: 2rem 2.5rem;
    border-bottom: 1px solid var(--border);
  }

  .pf-detail__title {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .pf-detail__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .pf-detail__list li {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.5;
    padding-left: 1rem;
    position: relative;
  }

  .pf-detail__list li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--accent-green);
  }

  .pf-card__tech {
    padding: 1.5rem 2.5rem;
  }

  .pf-tech__label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .pf-tech__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .pf-tech__chip {
    padding: 0.2em 0.6em;
    background: var(--accent-violet-dim);
    color: var(--accent-violet);
    border: 1px solid rgba(155, 140, 255, 0.2);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .projects-more {
    background: var(--bg-primary);
    border-top: 1px solid var(--hairline);
  }

  .pm-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-bright);
    margin-bottom: 0.5rem;
  }

  .pm-desc {
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .pm-card {
    padding: 2rem;
    background: var(--bg-panel);
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
    text-align: center;
  }

  .pm-card__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    display: block;
    margin-bottom: 0.5rem;
  }

  .pm-card__text {
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  .projects-cta {
    background: var(--bg-secondary);
    border-top: 1px solid var(--hairline);
  }

  .pcta {
    text-align: center;
    max-width: 480px;
    margin: 0 auto;
  }

  .pcta__title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-bright);
    margin-bottom: 0.75rem;
  }

  .pcta__desc {
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .pcta__btn {
    display: inline-flex;
    align-items: center;
    padding: 0.9rem 2.5rem;
    background: var(--accent-blue);
    color: var(--bg-primary);
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: var(--text-base);
    transition: background 0.2s, box-shadow 0.2s, transform 0.2s var(--ease-out-expo);
  }

  .pcta__btn:hover {
    background: var(--accent-blue-bright);
    box-shadow: var(--shadow-blue);
    transform: translateY(-2px);
  }

  @media (max-width: 900px) {
    .pf-card__details { grid-template-columns: 1fr; gap: 1.5rem; padding: 1.5rem; }
    .pf-card__head { padding: 2rem 1.5rem 1.5rem; }
    .pf-card__tech { padding: 1.25rem 1.5rem; }
    .pf-card__stats-grid { padding: 1.25rem 1.5rem; }
  }
</style>
