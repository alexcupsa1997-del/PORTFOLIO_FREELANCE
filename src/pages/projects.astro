---
import PageLayout from '../layouts/PageLayout.astro';
import FeaturedProject from '../components/projects/FeaturedProject.astro';
import PrivateProjectCard from '../components/projects/PrivateProject.astro';
import ProjectCard from '../components/projects/ProjectCard.astro';
import { featuredProjects, privateProjects } from '../data/projects';
import { fetchGitHubRepos } from '../utils/github';
import { pageLinks } from '../data/navigation';
import { site } from '../data/site';

const repos = await fetchGitHubRepos();
---

<PageLayout
  title={`Progetti — ${site.name}`}
  description="Progetti personali, repository GitHub e lavori privati di Alexandru Cupsa."
  navLinks={pageLinks}
>
  <main class="section projects-page" style="padding-top: calc(var(--nav-height) + 3rem);">
    <div class="container">

      <div class="section-header reveal">
        <span class="section-header__label">Progetti</span>
        <h1 class="section-header__title">Dal codice che scrivo per me</h1>
        <p class="section-header__subtitle">Applicazioni, strumenti e sistemi che costruisco — stessa filosofia, ambizioni diverse.</p>
      </div>

      <div class="projects__featured">
        {featuredProjects.map((project, i) => (
          <FeaturedProject project={project} class:list={['reveal', i > 0 && `reveal-delay-${i}`]} />
        ))}
      </div>

      <div class="projects__section reveal">
        <h2 class="projects__section-title">Progetti Privati</h2>
        <div class="projects__private">
          {privateProjects.map((project) => (
            <PrivateProjectCard project={project} />
          ))}
        </div>
      </div>

      {repos.length > 0 && (
        <div class="projects__section reveal">
          <h2 class="projects__section-title">GitHub</h2>
          <p class="section-header__subtitle" style="margin-bottom: 1.75rem;">
            Progetti tecnici personali — architetture che costruisco per
            approfondire stack enterprise. Non sono il focus commerciale attuale,
            ma dimostrano la profondità tecnica dietro ogni soluzione che consegno.
          </p>
          <div class="projects__repos">
            {repos.map((repo) => (
              <ProjectCard repo={repo} />
            ))}
          </div>
        </div>
      )}

      <div class="projects__back reveal">
        <a href="/PORTFOLIO_FREELANCE/" class="back-link">&larr; Torna alla Home</a>
      </div>

    </div>
  </main>
</PageLayout>

<style>
  .projects-page {
    background: var(--bg-primary);
    min-height: 100vh;
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .section-header__label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent-blue);
    margin-bottom: 0.75rem;
  }

  .section-header__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .section-header__subtitle {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 600px;
    line-height: 1.7;
  }

  .projects__featured {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .projects__section {
    margin-bottom: 3rem;
  }

  .projects__section-title {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .projects__private {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .projects__repos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .projects__back {
    text-align: center;
    margin-top: 3rem;
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    color: var(--accent-blue);
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: color 0.3s var(--ease-out-expo);
  }

  .back-link:hover {
    color: var(--accent-green);
  }

  @media (max-width: 1024px) {
    .projects__repos {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 767px) {
    .projects__private {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 0.75rem;
    }

    .projects__repos {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .projects__private {
      grid-template-columns: 1fr;
    }

    .projects__repos {
      grid-template-columns: 1fr;
    }
  }
</style>
